# TravelMitra Client Environment Variables
# API Base URL for backend communication
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Firebase Web Client Configuration (Optional for initial local dev, required for live Firebase Auth)
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
