# TravelMitra Server Environment Variables

# Application Environment & Server Port
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas connection string)
# Leave empty to run in limited local development mode without a database
MONGODB_URI=

# Firebase Admin SDK Configuration (Future backend authentication verification)
# Download from Firebase Console -> Project Settings -> Service accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay Payment Gateway (Phase 3 integration)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Free Flight Provider (Optional free AviationStack API key, otherwise native Indian Aviation Engine is used)
AVIATIONSTACK_API_KEY=

